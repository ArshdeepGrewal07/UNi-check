{
  "name": "lpu-campus-app",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node scripts/serve-local.mjs",
    "lint": "eslint src db drizzle.config.ts",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node tests/database.mjs",
    "db:push": "npm run db:generate && npm run db:migrate:local",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply uni-connect-db --local --persist-to .wrangler/state",
    "test:database": "node tests/database.mjs",
    "test:browser": "BROWSER_QA=1 node tests/database.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply uni-connect-db --remote",
    "test:student": "node tests/student-platform.mjs",
    "test:signup": "node tests/signup.mjs",
    "test:migration-upgrade": "node tests/migration-upgrade.mjs"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "^16.3.5",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.18.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "miniflare": "4.20260515.0",
    "postcss": "8.5.8",
    "react-server-dom-webpack": "^19.3.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.10",
    "vite": "^8.3.0",
    "wrangler": "4.92.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module"
}
